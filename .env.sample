# Secret key can be generated using this commande
# docker compose run --rm -it transportscolaire python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=<generate secret key>
DEBUG=false
# PostgreSQL is required for the read-only production container.
DATABASE_URL=postgresql://dbuser:dbpassword@dbhost:5432/dbname
ALLOWED_HOSTS=cerfafiller.example.org
SITE_URL=https://cerfafiller.example.org
CSRF_TRUSTED_ORIGINS=https://cerfafiller.example.org

# Reverse proxy / HTTPS
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Container startup (load fixtures manually on a fresh installation)
RUN_MIGRATIONS=true
LOAD_INITIAL_DATA=false
